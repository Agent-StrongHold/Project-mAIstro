# ─── REQUIRED: Database ──────────────────────────────
DB_PASSWORD=          # REQUIRED — generate with: openssl rand -hex 16

# ─── REQUIRED: LiteLLM ──────────────────────────────
LITELLM_MASTER_KEY=   # REQUIRED — generate with: openssl rand -hex 16

# ─── LiteLLM network exposure (default OFF) ─────────
# Which host interface the LiteLLM gateway (port 4000) binds to.
#   127.0.0.1  (default) — loopback ONLY: reachable from this machine only. OFF.
#   0.0.0.0              — all interfaces: reachable from other devices on your
#                          LAN (e.g. other PCs/phones pointing at this host:4000).
# The gateway is key-protected by LITELLM_MASTER_KEY, but exposing it means anyone
# who can reach this host on :4000 can attempt requests — only turn it ON on a
# trusted network and/or behind a firewall. Uncomment and set to 0.0.0.0 to enable.
# LITELLM_BIND_ADDR=0.0.0.0

# ─── Optional: use a hosted or corporate model gateway ───────
# By default the engine and Hive talk to the bundled LiteLLM proxy above. To
# use an existing gateway instead — a corporate LiteLLM, or any
# OpenAI-compatible endpoint — set its root URL (no /v1) and its key. Every
# gateway alias the services read is derived from these two, so there is
# nothing else to keep in step. LITELLM_MASTER_KEY is still required: the
# bundled proxy starts either way, it is just not what anything calls.
# LITELLM_BASE_URL=https://llm-gateway.example.com
# LITELLM_API_KEY=
# Only if its OpenAI-compatible path is not <root>/v1:
# LITELLM_API_BASE=https://llm-gateway.example.com/openai/v1

# ─── Model authorization (#1824, optional; empty = fail-closed) ──────
# Every governed model call needs an explicit Binding and a real gateway
# credential; nothing is authorized by default.
#
# MAISTRO_LLM_API_KEY — the deployment's own model key. When set (non-empty)
# it outranks the gateway aliases for BOTH the engine and Hive, per the
# effective-key precedence: vault MAISTRO_LLM_API_KEY → this key →
# LITELLM_API_KEY → LITELLM_PROXY_KEY → LITELLM_MASTER_KEY. Leave unset to
# use the gateway key above.
# MAISTRO_LLM_API_KEY=
#
# MAISTRO_MODEL_BINDINGS — JSON list of model.chat Bindings Hive's embedded
# runtime authorizes, e.g.
#   MAISTRO_MODEL_BINDINGS=[{"binding_id":"summarize","project_id":"p1","provider_name":"gemini/gemini-2.5-flash"}]
# Each names a Workspace (inherits the default one when omitted), a Project,
# and the provider/model it may call. No declaration authorizes no Binding:
# governed model nodes refuse before dispatch.
# MAISTRO_MODEL_BINDINGS=[]
#
# MAISTRO_CONFIG — path to the engine's documented maistro.yaml (mounted into
# the container at the same path). Its `model_bindings:` section is the
# engine's equivalent of the list above; a missing file stays empty and
# fail-closed. Example override in a compose.override.yml:
#   services:
#     maistro-engine:
#       volumes: ["./maistro.yaml:/app/maistro.yaml:ro"]
# then set MAISTRO_CONFIG=/app/maistro.yaml here.
# MAISTRO_CONFIG=

# ─── REQUIRED: Maistro API Auth ─────────────────────
# JSON array of API bearer tokens. Each entry names its explicit canonical
# principal: "principal:secret" (or "principal:admin:secret"). Plain
# secret-only entries are rejected at boot (#843) — they used to collapse
# every credential onto one shared "default" identity. Legacy installs: see
# docs/install/api-key-identity.md (rewriting "<secret>" as "ops:<secret>"
# keeps the same secret working, now attributed).
# Do not shell-source this file: Compose reads it directly and preserves the
# JSON quoting.
API_KEYS=[]           # REQUIRED — installer generates ["conductor:<random token>"]
ADMIN_API_KEYS=[]     # REQUIRED (use [] when no admin keys) — explicit administrator
                      # bearer tokens ("principal:secret"); authority comes only from
                      # this list, never from a role marker in the secret (#1095)
ROUTER_API_KEY=       # REQUIRED — installer generates a separate 256-bit key
TASK_DELEGATION_KEY=  # REQUIRED — separate HMAC key for Conductor user delegation
MAISTRO_SERVICE_PRINCIPAL=conductor

# ─── REQUIRED: Langfuse ─────────────────────────────
LANGFUSE_NEXTAUTH_SECRET=  # REQUIRED — generate with: openssl rand -hex 16
LANGFUSE_SALT=             # REQUIRED — generate with: openssl rand -hex 16

# ─── LLM API Keys ────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# ─── Default Model ───────────────────────────────────
DEFAULT_MODEL=anthropic/claude-sonnet-4-20250514

# ─── Langfuse Observability (optional) ───────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ─── Webhook Security (recommended) ─────────────────
GITHUB_WEBHOOK_SECRET=    # GitHub webhook HMAC secret
CI_WEBHOOK_SECRET=        # CI webhook shared token

# ─── Keycloak (for Open WebUI OIDC) ─────────────────
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_OIDC_URL=

# ─── Agent Conductor human login (optional OIDC) ─────
# Modes: local = password only; entra = Microsoft Entra only;
# hybrid = password + configured OIDC providers. Hybrid is the compatibility
# default and behaves like local when OAUTH_PROVIDERS is empty.
HUMAN_AUTH_MODE=hybrid
# Non-secret provider metadata as one JSON object. Callback URLs are fixed as
# <OAUTH_PUBLIC_ORIGIN>/v1/auth/oauth/<provider>/callback.
OAUTH_PROVIDERS={}
OAUTH_PUBLIC_ORIGIN=
OAUTH_SUCCESS_PATH=/
# Provider entries may name a client_secret_vault_key. Put its value in the
# Conductor's age-encrypted vault; never add the client secret to this file.
#
# Entra-only example. Replace both UUIDs. All four URLs must use the SAME tenant
# UUID; `common`, `organizations`, mutable email/UPN, and UserInfo identity are
# deliberately not accepted for MAIstro account identity.
# HUMAN_AUTH_MODE=entra
# OAUTH_PUBLIC_ORIGIN=https://maistro.example.com
# OAUTH_PROVIDERS={"entra":{"authorization_url":"https://login.microsoftonline.com/<tenant-uuid>/oauth2/v2.0/authorize","token_url":"https://login.microsoftonline.com/<tenant-uuid>/oauth2/v2.0/token","client_id":"<application-client-id>","jwks_url":"https://login.microsoftonline.com/<tenant-uuid>/discovery/v2.0/keys","issuer":"https://login.microsoftonline.com/<tenant-uuid>/v2.0","scopes":["openid","profile","email"],"client_secret_vault_key":"HIVE_OAUTH_ENTRA_CLIENT_SECRET"}}

# ─── PM Fleet POC (research/pm-fleet-poc) ───────────
# Place these in repo-root .env — scripts/dev-pm-poc.sh sources it automatically.
MAISTRO_POC_MODE=pm
HIVE_POC_MODE=pm
# API_KEYS=<generated by ./install.sh>   # EXAMPLE ONLY — not a usable value.
#   Real keys are generated per install and never committed. The placeholder
#   above is deliberately not valid syntax so copying this line cannot
#   produce a working credential (#367).
# CORS_ORIGINS=http://localhost:8101,http://localhost:5173
# VITE_POC_MODE=pm
# HIVE_CREDENTIALS_MASTER_KEY=   # optional; auto-generated under ~/.conductor/ on first boot

# ─── Dev Overrides ───────────────────────────────────
# REQUIRE_AUTH=false      # Disable auth check (local dev only)
# DEBUG=true              # Enable console logging + debug mode
# MAISTRO_DRY_RUN=1      # Skip LLM calls, return mock results
