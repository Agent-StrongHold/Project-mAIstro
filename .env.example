# ─── REQUIRED: Database ──────────────────────────────
DB_PASSWORD=          # REQUIRED — generate with: openssl rand -hex 16

# ─── REQUIRED: LiteLLM ──────────────────────────────
LITELLM_MASTER_KEY=   # REQUIRED — generate with: openssl rand -hex 16

# ─── LiteLLM network exposure (default OFF) ─────────
# Which host interface the LiteLLM gateway (port 4000) binds to.
#   127.0.0.1  (default) — loopback ONLY: reachable from this machine only. OFF.
#   0.0.0.0              — all interfaces: reachable from other devices on your
#                          LAN (e.g. other PCs/phones pointing at this host:4000).
# The gateway is key-protected by LITELLM_MASTER_KEY, but exposing it means anyone
# who can reach this host on :4000 can attempt requests — only turn it ON on a
# trusted network and/or behind a firewall. Uncomment and set to 0.0.0.0 to enable.
# LITELLM_BIND_ADDR=0.0.0.0

# ─── REQUIRED: Maistro API Auth ─────────────────────
# Comma-separated list of valid API bearer tokens
API_KEYS=             # REQUIRED — generate with: openssl rand -hex 32

# ─── REQUIRED: Langfuse ─────────────────────────────
LANGFUSE_NEXTAUTH_SECRET=  # REQUIRED — generate with: openssl rand -hex 16
LANGFUSE_SALT=             # REQUIRED — generate with: openssl rand -hex 16

# ─── LLM API Keys ────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# ─── Default Model ───────────────────────────────────
DEFAULT_MODEL=anthropic/claude-sonnet-4-20250514

# ─── Langfuse Observability (optional) ───────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ─── Webhook Security (recommended) ─────────────────
GITHUB_WEBHOOK_SECRET=    # GitHub webhook HMAC secret
CI_WEBHOOK_SECRET=        # CI webhook shared token

# ─── Keycloak (for Open WebUI OIDC) ─────────────────
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_OIDC_URL=

# ─── PM Fleet POC (research/pm-fleet-poc) ───────────
# Place these in repo-root .env — scripts/dev-pm-poc.sh sources it automatically.
MAISTRO_POC_MODE=pm
HIVE_POC_MODE=pm
# API_KEYS=<generated by ./install.sh>   # EXAMPLE ONLY — not a usable value.
#   Real keys are generated per install and never committed. The placeholder
#   above is deliberately not valid syntax so copying this line cannot
#   produce a working credential (#367).
# CORS_ORIGINS=http://localhost:8101,http://localhost:5173
# VITE_POC_MODE=pm
# HIVE_CREDENTIALS_MASTER_KEY=   # optional; auto-generated under ~/.conductor/ on first boot

# ─── Dev Overrides ───────────────────────────────────
# REQUIRE_AUTH=false      # Disable auth check (local dev only)
# DEBUG=true              # Enable console logging + debug mode
# MAISTRO_DRY_RUN=1      # Skip LLM calls, return mock results
