{
  "$comment": [
    "Reviewable source of truth for the live GitHub merge-boundary rules (#162).",
    "M0 uses repository Rulesets, not classic branch protection. The fields under",
    "`branches` retain the classic request vocabulary where it maps cleanly so the",
    "existing offline workflow/check audit remains useful; `ruleset` records the",
    "Ruleset-only semantics needed to reconstruct the live settings.",
    "The live topology is topic branches -> develop -> main. `integration` is retired."
  ],
  "$adr": "docs/adr/ADR-095-four-tier-branch-model.md",
  "base_coupled_to": {
    "$comment": ["Checks that report only on main-based PRs."],
    "Container scan + SBOM + cosign": ["main"]
  },
  "branches": {
    "develop": {
      "$comment": [
        "Canonical development branch. PR-gated, zero approvals, linear history.",
        "Required checks include the base-trusted autonomous judge and gates-ran."
      ],
      "required_status_checks": {
        "strict": true,
        "contexts": [
          "docker-build", "hive-conductor-e2e", "hive-conductor-e2e-ui",
          "lint-and-type-check", "security", "test", "wheel-imports", "workflow-lint",
          "autonomous-merge-admissibility", "block", "formal-conformance",
          "Gate C — canonical clean install", "Validate ADR/spec front-matter",
          "exact-debt-ledger", "Quality gate (Pillars 1–4, 7, 8)",
          "SAST (bandit + semgrep + gitleaks)", "Supply chain (pip-audit)",
          "coverage (no services)", "coverage (MinIO)",
          "Coverage gate (publish-set floor + diff coverage)", "strike-ladder",
          "durable-events", "coverage (PostgreSQL)", "object storage (MinIO)",
          "postgres (pg17)", "postgres (pg18)", "gates-ran"
        ]
      },
      "enforce_admins": false,
      "required_pull_request_reviews": {
        "required_approving_review_count": 0,
        "dismiss_stale_reviews": true,
        "require_code_owner_reviews": false,
        "require_last_push_approval": false
      },
      "restrictions": null,
      "required_linear_history": true,
      "allow_force_pushes": false,
      "allow_deletions": false,
      "required_conversation_resolution": true,
      "block_creations": true,
      "lock_branch": false,
      "allow_fork_syncing": false,
      "ruleset": {
        "name": "Pr merge",
        "target": "~DEFAULT_BRANCH",
        "allowed_merge_methods": ["squash", "rebase"],
        "bypass": {"OrganizationAdmin": "always", "RepositoryRole:admin": "always"}
      }
    },
    "main": {
      "$comment": [
        "Release/promotion branch. Ordinary changes reach main through develop -> main PRs.",
        "One approval is required. Merge commits are intentionally allowed as release markers;",
        "linear history is therefore not required on main. Creation is restricted."
      ],
      "required_status_checks": {
        "strict": true,
        "contexts": [
          "docker-build", "hive-conductor-e2e", "hive-conductor-e2e-ui",
          "lint-and-type-check", "security", "test", "wheel-imports", "workflow-lint",
          "autonomous-merge-admissibility", "block", "formal-conformance",
          "Gate C — canonical clean install", "Validate ADR/spec front-matter",
          "exact-debt-ledger", "Quality gate (Pillars 1–4, 7, 8)",
          "SAST (bandit + semgrep + gitleaks)", "Supply chain (pip-audit)",
          "coverage (no services)", "coverage (MinIO)",
          "Coverage gate (publish-set floor + diff coverage)", "strike-ladder",
          "durable-events", "coverage (PostgreSQL)", "object storage (MinIO)",
          "postgres (pg17)", "postgres (pg18)", "gates-ran",
          "Container scan + SBOM + cosign", "Analyze (actions)",
          "Analyze (javascript-typescript)", "Analyze (python)"
        ]
      },
      "enforce_admins": false,
      "required_pull_request_reviews": {
        "required_approving_review_count": 1,
        "dismiss_stale_reviews": true,
        "require_code_owner_reviews": false,
        "require_last_push_approval": false
      },
      "restrictions": null,
      "required_linear_history": false,
      "allow_force_pushes": false,
      "allow_deletions": false,
      "required_conversation_resolution": true,
      "block_creations": true,
      "lock_branch": false,
      "allow_fork_syncing": false,
      "ruleset": {
        "name": "Main merge",
        "target": "refs/heads/main",
        "allowed_merge_methods": ["squash", "rebase", "merge"],
        "bypass": {"OrganizationAdmin": "pull_request", "RepositoryRole:admin": "pull_request"}
      }
    }
  },
  "advisory": {
    "$comment": ["Checks that are deliberately non-required must be named here with a reason."]
  },
  "repository": {
    "allow_auto_merge": true,
    "delete_branch_on_merge": true,
    "$comment": [
      "Auto-merge is enabled only behind required checks.",
      "develop remains linear; main permits an explicit release/promotion merge commit."
    ]
  }
}
