# Python
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Environment
.env
.env.local

# Test/Coverage
.pytest_cache/
htmlcov/
.coverage
# Parallel-mode data files: `.coverage.<host>.<pid>.<random>`, which the bare
# `.coverage` pattern above does not match. One of these was committed by a
# `git add -A` and reached CI, where `coverage combine` picked it up and
# `coverage report` then failed on absolute paths belonging to the machine
# that produced it — a green local run turning the shared gate red.
.coverage.*
coverage.xml
.hypothesis/

# Claude Code — share project skills + hooks, keep personal/runtime files local
.claude/*
!.claude/skills/
!.claude/settings.json

# Database
*.db
*.sqlite

# Docker
acme.json

# Frontend
node_modules/
test-results/

# OS
.DS_Store
Thumbs.db

# Node.js — install per package with npm ci / npm install (never commit)
node_modules/

# Cursor (local overrides — keep project .cursor/ rules committed)
.cursor/mcp.local.json
.cursor/hooks/state/
.cursor/hooks/*.log

# Frozen snapshots — do not commit at repo root (see docs/specs/SPEC-178-legacy-snapshot-retention.md).
# These patterns block accidental re-vendoring of large snapshot trees at repo root.
code-worth-implementing-from-*/

# Materialized installer plan + staged bootstrap credentials (install.sh)
.maistro-install/

# Generated by scripts/check-ac-state.py on every run. It is the 4,700-line
# per-decision measurement, it was the larger half of the queue-serializing
# conflict, and nothing reads the committed copy as an oracle now that the
# bound is folded from quality/ac-state-notes/ (#585, ADR-082926-25a2).
quality/ac-state.json
