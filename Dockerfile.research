# maistro-engine RESEARCH worker image.
#
# The browser surface (browser-use + Playwright + Chromium) that used to live in
# the main API image (Dockerfile) was split out here — it was "the single largest
# remaining CVE source", and Chromium needs a glibc + X-libs base, so it can't go
# on the Wolfi/distroless API image. This is its deliberately-isolated home.
#
# Build it only where the RESEARCH web tool is actually run:
#   docker build -f Dockerfile.research -t maistro-engine-research .
# maistro's browser client lazy-imports browser_use, so the main API image boots
# fine without it and raises a clear error if the tool is invoked there.

# ─── Build stage ───────────────────────────────────────
# Digest-pinned (#349): python:3.12-slim resolved to this index digest on
# 2026-09-30; refresh via Dependabot and update quality/image-pins.json.
FROM python:3.12-slim@sha256:a6e34c598f2467ed0e9a8d349809fcd8b5c603269512df273a0bb1784edc11b1 AS builder

WORKDIR /app

# CI evidence (run 36835563311, job 110282105809): BOTH buildx attempts of
# this image died inside pip on `files.pythonhosted.org` read timeouts --
# pip's 15s default, under runner load, on metadata fetches and a ~950KB
# wheel. The resolution itself is sound (a pip --dry-run of the same
# requirements resolves cleanly), so the defect is transport patience, not
# pinning. State the patience instead of rediscovering it on the next
# registry slow spell; buildx-build-retry.sh still retries the whole
# invocation above this layer.
ENV PIP_DEFAULT_TIMEOUT=60 \
    PIP_RETRIES=10

# uv is the installer tool image — pinned to the 0.12.21 release (the release
# `:latest` resolved to on 2026-09-30, #349). A `:latest` tag could swap the
# installer under every build; an immutable digest cannot.
COPY --from=ghcr.io/astral-sh/uv:0.12.21@sha256:a7aed3216253ee804de3e2d8afa5073baa1a177335345d43845cd4165e43b711 /uv /usr/local/bin/uv

COPY pyproject.toml uv.lock README.md ./
COPY packages/maistro-core packages/maistro-core
COPY packages/maistro-server packages/maistro-server

# Production API: core (with the extras the server uses) + server.
# pip, not uv, for the reason recorded at the runtime-stage install below:
# building a local path makes uv read the root workspace tables, and this
# image copies two of the seven members.
RUN pip install --no-cache-dir \
    "./packages/maistro-core[llm,sandbox,observability]" \
    "./packages/maistro-server"


# ---- docker CLI build ----
# Same policy as the root Dockerfile: the published docker:29-cli binary embeds
# go1.26.8 stdlib (trivy HIGHs fixed in go1.26.9/1.27.2) and no released
# docker:xx-cli tag ships a newer toolchain, so build the exact immutable
# release tag ourselves on the patched toolchain. Tag resolves to dfc520d; fail
# if upstream ever disagrees.
FROM golang:1.27.2-alpine@sha256:f92b6ef800e499660581efdabdf25d9d817a9d124eaf900924f0504e7e27e12d AS dockerclibuild
ARG DOCKER_CLI_VERSION=29.9.1
ARG DOCKER_CLI_COMMIT_SHORT=dfc520d
RUN apk add --no-cache git && \
    git clone --branch "v${DOCKER_CLI_VERSION}" --depth 1 https://github.com/docker/cli.git /src/docker-cli && \
    cd /src/docker-cli && \
    test "$(git rev-parse --short=7 HEAD)" = "${DOCKER_CLI_COMMIT_SHORT}" && \
    cp vendor.mod go.mod && cp vendor.sum go.sum && \
    mkdir -p /out && \
    CGO_ENABLED=0 go build -trimpath -tags grpcnotrace \
      -ldflags="-s -w -X github.com/docker/cli/cli/version.Version=v${DOCKER_CLI_VERSION} -X github.com/docker/cli/cli/version.GitCommit=${DOCKER_CLI_COMMIT_SHORT}" \
      -o /out/docker ./cmd/docker

# ─── Production stage ─────────────────────────────────
FROM python:3.12-slim@sha256:a6e34c598f2467ed0e9a8d349809fcd8b5c603269512df273a0bb1784edc11b1

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    # Same transport-patience fix as the builder stage above: this stage's
    # pip install was the second of the two timeouts in run 36835563311.
    PIP_DEFAULT_TIMEOUT=60 \
    PIP_RETRIES=10 \
    # Browsers installed to a world-readable path so the non-root runtime user
    # can find Chromium (default ~/.cache/ms-playwright is root-only).
    PLAYWRIGHT_BROWSERS_PATH=/opt/playwright

# System layer. Hardening vs the previous image:
#   - apt-get upgrade applies Debian security patches the base tag froze.
#   - docker.io (the whole engine) replaced by a static docker CLI (see COPY below).
#   - curl + wget removed; the HEALTHCHECK now uses stdlib Python.
#   - autoremove/clean drop orphaned deps and caches.
# The libnss3…fonts-liberation block is the Chromium runtime surface for the
# RESEARCH browser tool. It is isolated to THIS image; the main API image is
# Wolfi/browser-free.
RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends \
    git \
    libnss3 libnspr4 libatk1.0-0 libatk-bridge2.0-0 libcups2 libdrm2 \
    libxkbcommon0 libxcomposite1 libxdamage1 libxfixes3 libxrandr2 \
    libgbm1 libpango-1.0-0 libcairo2 libasound2 libatspi2.0-0 \
    fonts-liberation \
    && apt-get autoremove -y --purge \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /var/cache/apt/* /tmp/*

# Static docker CLI only (talks to a mounted /var/run/docker.sock) — replaces the
# heavyweight docker.io package and its containerd/runc dependency tree. Built
# from the pinned upstream release tag on the patched Go toolchain (stage
# above) because the published 29-cli binary embeds go1.26.8 stdlib (trivy HIGHs).
COPY --from=dockerclibuild /out/docker /usr/local/bin/docker

# Copy installed packages from builder
COPY --from=builder /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# Application sources (editable installs reference these paths)
COPY packages/maistro-core packages/maistro-core
COPY packages/maistro-server packages/maistro-server
COPY alembic/ alembic/
COPY alembic.ini .
COPY pyproject.toml uv.lock README.md ./

# Install the workspace packages with pip, not uv, and non-editable.
#
# `uv pip install` on a local path builds that path's project, which makes uv
# read the root `pyproject.toml` -- and this image copies only maistro-core and
# maistro-server, while the root declares `[tool.uv.workspace] members =
# ["packages/*"]` with `workspace = true` sources for five packages that are
# not here. uv aborts:
#
#   Failed to parse entry: `maistro-bootstrap`
#   `maistro-bootstrap` references a workspace in `tool.uv.sources`, but is
#   not a workspace member
#
# So this image could not be built at all, and nothing noticed because nothing
# built it -- which is the whole of #346 in one line. pip does not read
# `[tool.uv.sources]`, which is why the main Dockerfile (identical partial
# context) builds; matching it here is the smallest fix that does not drag five
# unrelated packages into a browser image. Named packages are still fine on uv
# -- nothing local is built -- so the Playwright step below is unchanged.
COPY --from=ghcr.io/astral-sh/uv:0.12.21@sha256:a7aed3216253ee804de3e2d8afa5073baa1a177335345d43845cd4165e43b711 /uv /usr/local/bin/uv
# pydantic-ai-slim is deliberately NOT installed: ADR-094 cut pydantic-ai from
# the codebase (zero src imports) and the CVE-2026-25580 fix line (>=1.56.0)
# requires openai>=2, which cannot co-install with the openai pin below.
RUN pip install --no-cache-dir \
    "./packages/maistro-core[llm,sandbox,observability]" \
    "./packages/maistro-server" \
    "alembic>=1.14" \
    "openai>=1.40,<2" \
    "anyio>=4.14.2" \
    "httpx>=0.27.0"

# Install browser-use + Playwright + Chromium for the RESEARCH role's web tool.
# Installed into PLAYWRIGHT_BROWSERS_PATH (set above) so the non-root user can use it.
RUN uv pip install --system \
    "browser-use>=0.1.40" \
    "playwright>=1.49.0" \
 && python -m playwright install chromium \
 && uv pip install --system \
    "anyio>=4.14.2" \
    "aiohttp>=3.14.4" \
    "pypdf>=6.19.0" \
 && python -c "from importlib.metadata import version; import anyio, pypdf, browser_use; assert version('anyio') >= '4.14.2', version('anyio'); assert version('aiohttp') >= '3.14.4', version('aiohttp'); assert version('pypdf') >= '6.19.0', version('pypdf')" \
 && rm -rf /root/.cache/uv
# The second uv install re-asserts the security floors the first one cannot
# carry: browser-use 0.13.11 (the latest upstream release) pins
# anyio==4.12.1 (CVE-2026-63374 CRITICAL, TLS certificate spoofing, fixed
# 4.14.2), pypdf==6.16.2 (CVE-2026-102993/4/5/8 HIGHs, fixed 6.17-6.19), and
# aiohttp==3.14.3 (CVE-2026-111064 missing-initial-request-timeout DoS HIGH
# and GHSA-2g87-pp6c-29x5 unbounded memory/CPU HIGH, both fixed 3.14.4)
# exactly, so its resolution silently downgrades whatever the first install
# put in place — CI run 39400043294 shipped aiohttp 3.14.3 to this image that
# way and the trivy gate failed on it. Every browser-use release to date pins
# aiohttp exactly, so the pin cannot be satisfied jointly with the CVE floor;
# the patched aiohttp replaces the pinned one after browser-use is installed.
# anyio/aiohttp/pypdf keep their public API across these minors; the import
# assertion above fails the build if that ever stops holding. The uv wheel
# cache is dropped in the same layer: its archives keep the METADATA of every
# wheel uv resolved (the vulnerable tuples again) plus SDK example files the
# secret scanner flags.

# Drop the same build tooling the other images drop: pip is not invoked at
# runtime by anything in the shipped app, and its vendored dependency tree
# (pip/_vendor/vendor.txt) is trivy surface. The uv binary stays — it ships in
# the copied /usr/local/bin tool set this image is operated with.
RUN rm -rf /usr/local/lib/python3.12/site-packages/pip* \
           /usr/local/bin/pip*

# Drop root: run as an unprivileged system user and own the app + browser dirs.
RUN useradd --system --no-create-home --uid 10001 app \
 && chown -R app:app /app /opt/playwright
USER 10001

EXPOSE 8000

STOPSIGNAL SIGTERM

# stdlib healthcheck — no curl in the image. Exits 0 on HTTP 200, 1 otherwise.
HEALTHCHECK --interval=10s --timeout=5s --retries=3 \
    CMD ["python", "-c", "import sys,urllib.request; sys.exit(0 if urllib.request.urlopen('http://localhost:8000/health/live', timeout=4).status==200 else 1)"]

CMD ["uvicorn", "maistro_server.main:app", "--host", "0.0.0.0", "--port", "8000"]
