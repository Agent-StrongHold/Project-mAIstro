# maistro-engine RESEARCH worker image.
#
# The browser surface (browser-use + Playwright + Chromium) that used to live in
# the main API image (Dockerfile) was split out here — it is "the single largest
# remaining CVE source", and Chromium needs a glibc + X-libs base, so it can't go
# on the Wolfi/distroless API image. This is its deliberately-isolated home.
#
# Build it only where the RESEARCH web tool is actually run:
#   docker build -f Dockerfile.research -t maistro-engine-research .
# maistro's browser client lazy-imports browser_use, so the main API image boots
# fine without it and raises a clear error if the tool is invoked there.
#
# Dependency contract (#348): everything Python in this image comes from the
# committed uv.lock. The builder exports the locked requirement set for
# maistro-server plus core's observability and browser extras and installs it
# with --require-hashes, so exact versions AND hashes are enforced:
#   --locked  fails the build on lock-vs-pyproject drift;
#   --require-hashes
#             fails the build on an unresolvable locked artifact instead of
#             silently installing whatever the index serves;
#   --no-dev
#             dev tooling never ships;
#   --no-emit-workspace
#             third-party pins only; the workspace members are installed from
#             the copied sources with --no-deps (a local wheel build, not a
#             dependency resolution).
# This replaces the previous `pip install ./packages/... "browser-use>=0.1.40"`
# lines, which re-resolved at build time — the browser stack (200+ transitives)
# was whichever snapshot PyPI served that day, while the scanners audited the
# lock. browser-use, playwright and openai now resolve through core's `browser`
# extra (its tool lazy-imports all three), so the shipped set is the locked set.
#
# The bip-utils extra is deliberately NOT selected here, exactly as before
# #348: this image shipped core[llm,sandbox,observability] and nothing else.
# That extra drags in pytoniq-core-fork, whose wheel installs a generic
# top-level `examples` namespace package — the payload the shipped images
# prune (#406). This image does not prune (it has no bip-utils stack to
# prune), so selecting the extra here would ship that namespace unpruned.
# The engine image is the one that selects it, and it prunes in the same layer
# it asserts.

# ─── Build stage ───────────────────────────────────────
# Digest-pinned (#349): python:3.12-slim resolved to this index digest on
# 2026-09-30; refresh via Dependabot and update quality/image-pins.json.
FROM python:3.12-slim@sha256:f77ac9e44ae96ef2c90b8053ea08c31f8be030f824196b0ae4db6d462c84e51f AS builder

WORKDIR /app

# uv is the installer tool image — pinned to the 0.12.21 release (the release
# `:latest` resolved to on 2026-09-30, #349). A `:latest` tag could swap the
# installer under every build; an immutable digest cannot. The same pinned uv
# generates the committed uv.lock, and `uv export --locked` below is
# version-sensitive (#348).
COPY --from=ghcr.io/astral-sh/uv:0.12.21@sha256:a7aed3216253ee804de3e2d8afa5073baa1a177335345d43845cd4165e43b711 /uv /usr/local/bin/uv
# Transport patience, stated instead of rediscovered: CI evidence (run
# 36835563311, job 110282105809) shows both buildx attempts of this image
# dying on `files.pythonhosted.org` read timeouts under runner load. The
# installs below are uv's now (#348), so the patience is uv's too.
ENV UV_LINK_MODE=copy \
    UV_HTTP_TIMEOUT=120 \
    UV_MAX_RETRIES=10

# uv needs every workspace member's pyproject.toml to verify `--locked`;
# only maistro-core and maistro-server are installed from them. The
# reference extension is a workspace member too, and its pyproject.toml is
# what the export needs to resolve the selection (without it the export
# fails: "reference-greeter references a workspace in tool.uv.sources ...
# but is not a workspace member"). It is never installed here.
COPY pyproject.toml uv.lock README.md ./
COPY packages/ packages/
COPY extensions/ extensions/

RUN uv export --locked --package maistro-server \
      --extra observability --extra browser \
      --no-dev --no-emit-workspace \
      --format requirements-txt --output-file /tmp/lock-requirements.txt \
 && uv venv --python 3.12 /app/venv \
 && uv pip install --python /app/venv/bin/python \
      --require-hashes --no-cache -r /tmp/lock-requirements.txt \
 && uv pip install --python /app/venv/bin/python --no-deps --no-cache \
      ./packages/maistro-core ./packages/maistro-server \
 && uv pip check --python /app/venv/bin/python \
 && /app/venv/bin/python -c "import importlib.metadata as m; assert m.version('browser-use') and m.version('playwright'); import maistro_server.main; print('builder smoke ok')"

# ─── Production stage ─────────────────────────────────
FROM python:3.12-slim@sha256:f77ac9e44ae96ef2c90b8053ea08c31f8be030f824196b0ae4db6d462c84e51f

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    # Browsers installed to a world-readable path so the non-root runtime user
    # can find Chromium (default ~/.cache/ms-playwright is root-only).
    PLAYWRIGHT_BROWSERS_PATH=/opt/playwright \
    PATH="/app/venv/bin:$PATH"

# System layer. Hardening vs the previous image:
#   - apt-get upgrade applies Debian security patches the base tag froze.
#   - docker.io (the whole engine) replaced by a static docker CLI (see COPY below).
#   - curl + wget removed; the HEALTHCHECK now uses stdlib Python.
#   - autoremove/clean drop orphaned deps and caches.
# The libnss3…fonts-liberation block is the Chromium runtime surface for the
# RESEARCH browser tool. It is isolated to THIS image; the main API image is
# Wolfi/browser-free.
RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends \
    git \
    libnss3 libnspr4 libatk1.0-0 libatk-bridge2.0-0 libcups2 libdrm2 \
    libxkbcommon0 libxcomposite1 libxdamage1 libxfixes3 libxrandr2 \
    libgbm1 libpango-1.0-0 libcairo2 libasound2 libatspi2.0-0 \
    fonts-liberation \
    && apt-get autoremove -y --purge \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /var/cache/apt/* /tmp/*

# Static docker CLI only (talks to a mounted /var/run/docker.sock) — replaces the
# heavyweight docker.io package and its containerd/runc dependency tree.
# 29-cli ships a binary built with go1.26.8; older 27-cli
# binaries embedded go1.22.11 (CVE-2025-68121 crypto/tls + 21 HIGHs, trivy).
COPY --from=docker:29-cli@sha256:018edbc908e08fcc9dbf029c812c34251e9b4719e6f71ca0e5eae2a987d014ca /usr/local/bin/docker /usr/local/bin/docker
# The lock-built venv (third-party pins hash-verified, members non-editable).
COPY --from=builder /app/venv /app/venv

# Application sources — on-disk assets the app reads at runtime (agent YAML,
# prompts, migrations) and the two packages' data files. The venv is
# non-editable, so these are not on sys.path; they are still read from disk.
COPY packages/maistro-core packages/maistro-core
COPY packages/maistro-server packages/maistro-server
COPY alembic/ alembic/
COPY alembic.ini .
COPY pyproject.toml uv.lock README.md ./

# Install the Chromium binary for the RESEARCH role's web tool. The playwright
# package driving it is hash-pinned by the lock (builder stage); this step
# downloads a browser binary, not a Python dependency, so no package
# resolution happens here. Installed into PLAYWRIGHT_BROWSERS_PATH (set above)
# so the non-root user can use it.
RUN python -m playwright install chromium
# Drop root: run as an unprivileged system user and own the app + browser dirs.
RUN useradd --system --no-create-home --uid 10001 app \
 && chown -R app:app /app /opt/playwright
USER 10001

EXPOSE 8000

STOPSIGNAL SIGTERM

# stdlib healthcheck — no curl in the image. Exits 0 on HTTP 200, 1 otherwise.
HEALTHCHECK --interval=10s --timeout=5s --retries=3 \
    CMD ["python", "-c", "import sys,urllib.request; sys.exit(0 if urllib.request.urlopen('http://localhost:8000/health/live', timeout=4).status==200 else 1)"]

CMD ["uvicorn", "maistro_server.main:app", "--host", "0.0.0.0", "--port", "8000"]
