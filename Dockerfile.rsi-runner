# Full-isolation RSI runner: the ENTIRE self-improvement loop (agent, git,
# tests, coverage, fitness) executes inside this container. The host is never
# touched — nothing syncs back. Agent-authored code only ever runs in here.
#
# The loop uses --isolation local *inside* the container: "local" == this
# container's own filesystem, which IS the sandbox boundary. The agent reaches
# the LiteLLM gateway on the host via host.docker.internal (set at run time).
#
# Build:  docker build -f Dockerfile.rsi-runner -t maistro-rsi-runner:latest .
# Run:    see tools/run_rsi_isolated.sh (or the docker run in the session).
FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    git curl build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_LINK_MODE=copy

WORKDIR /workspace

# An explicit allowlist, not `COPY . /workspace` (#308). Two ignore files stand
# between this and the operator's `.env`, and they are the right defence -- but
# a deny-list is a claim about everything that exists, re-made every time
# someone adds a file. This is a claim about what the loop NEEDS, which is a
# shorter list and a fixed one. A new top-level directory has to be named here
# before it can reach an image that runs agent-authored code.
#
# scripts/check-build-context.py keeps this in agreement with the ignore files.
COPY pyproject.toml uv.lock VERSION conftest.py alembic.ini /workspace/
COPY packages /workspace/packages
COPY scripts /workspace/scripts
COPY tests /workspace/tests
COPY formal /workspace/formal
COPY tools /workspace/tools
COPY quality /workspace/quality
COPY alembic /workspace/alembic
COPY agents /workspace/agents
COPY templates /workspace/templates
# The loop reads specs and ADRs: `spec_tracker` scores new acceptance criteria
# and `check-ac-state` folds them, so a candidate that adds a criterion is
# unscoreable without these.
COPY docs /workspace/docs
# CLAUDE.md and AGENTS.md are the agent's own instructions; the rest are read
# by the doc-regression gate in the fitness scorecard.
COPY CLAUDE.md AGENTS.md README.md CONTRIBUTING.md SECURITY.md /workspace/
# `.gitignore` comes in with them, and it earns its place: the RUN below does
# `git add -A` on a fresh repo, and `_run_variant` does the same on every
# candidate. Without it, a `.pytest_cache/` or `.coverage.<host>.<pid>` the
# agent's own test run produced is committed into the candidate and can be
# carried out in a promotion patch (Codex, #510).
COPY .gitattributes .python-version .gitignore /workspace/
# Repository fixtures the scoped test command reads directly. Neither is
# incidental: `tools/run_rsi_isolated.sh` runs `packages/maistro-rsi/tests`,
# where `test_sandbox.py` reads `sbx/maistro-rsi/spec.yaml` and
# `test_harvest_entry_point.py` reads `.github/workflows/rsi-harvest.yml`.
# Absent, six tests fail with FileNotFoundError -- in the BASELINE run, which
# every candidate is scored against, so every candidate is rejected on its
# merits regardless of what it changed (Codex, #510).
#
# Both trees are on the RSI containment surface (`SENSITIVE_PATH_PATTERNS`
# names `.github/` and `sbx/`), so a candidate may read them here and no patch
# touching either can leave the loop.
COPY sbx /workspace/sbx
COPY .github /workspace/.github

# The build context is a linked git worktree (its .git is a file pointing
# outside the context), so bake a fresh, self-contained repo the loop can clone.
# Normalise text files to LF first: the build context is copied from a Windows
# checkout (CRLF), but the in-container agent writes LF — without this every
# agent edit diffs as a whole-file CRLF->LF rewrite, which defeats the
# complementary-merge (patches can't cleanly apply) and inflates every diff.
RUN find . -type f \( -name '*.py' -o -name '*.md' -o -name '*.txt' -o -name '*.toml' \
        -o -name '*.yaml' -o -name '*.yml' -o -name '*.cfg' -o -name '*.ini' \) \
        -print0 | xargs -0 -r sed -i 's/\r$//' \
    && rm -rf .git \
    && git init -q \
    && git add -A \
    && git -c user.email=rsi@maistro.local -c user.name=RSI commit -qm "rsi baseline snapshot"

# Install the workspace (maistro-core/evolve/rsi/bootstrap + their deps) plus the
# fitness toolchain, so tests/coverage/lint gates all run in-container.
RUN uv sync --python 3.12 --frozen || uv sync --python 3.12
RUN uv pip install coverage bandit radon interrogate vulture pylint

CMD ["sleep", "infinity"]
