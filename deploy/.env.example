# Copy to .env next to your compose invocation and fill in — never commit .env.
POSTGRES_USER=maistro
POSTGRES_DB=maistro
POSTGRES_PASSWORD=change-me
REPLICATION_PASSWORD=change-me
REDIS_PASSWORD=change-me
# Each API key names its explicit principal (#843): principal:secret.
# Plain secret-only entries are rejected at boot — see
# docs/install/api-key-identity.md for the one-line migration.
# A JSON list, as the server parses it. `API_KEYS=conductor:change-me` -- what
# this line used to say -- is not JSON, and every replica crash-looped on
# boot with: error parsing value for field "api_keys".
API_KEYS=["conductor:change-me"]
# Must match Hive's MAISTRO_DELEGATION_KEY; never reuse the API key.
TASK_DELEGATION_KEY=change-me-delegation
# Required: the server will not start without it. 256 bits, separate from
# every other key here -- generate with: openssl rand -hex 32
ROUTER_API_KEY=change-me-router-key
MAISTRO_LB_PORT=8080
MAISTRO_BIND_HOST=0.0.0.0
# The model gateway (required). This stack runs none of its own: point it at
# a LiteLLM proxy or any OpenAI-compatible endpoint. The root, without /v1;
# set LITELLM_API_BASE as well only if its OpenAI path is not <root>/v1.
LITELLM_BASE_URL=https://llm-gateway.example.com
LITELLM_API_KEY=change-me
# LITELLM_API_BASE=https://llm-gateway.example.com/openai/v1
# Optional:
# BACKUP_ROOT=/var/backups/maistro
# REMOTE_TARGET=
