{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Agent-StrongHold/Project-mAIstro/develop/docs/testing/installed-workspace-proof.schema.json",
  "title": "Installed workspace release-proof envelope, v1 (#1878)",
  "description": "Structural contract for the three documents of an installed-workspace release-proof envelope: the independently supplied reviewed profile, the bundle manifest.json, and the bundle results.json. The validator (scripts/validate-installed-workspace-proof.py) validates each document against the matching $defs entry. Every object rejects additional properties, no field carries an implicit default, and the reviewed profile deliberately defines no switch that can waive any of the five mandatory scenario families.",
  "oneOf": [
    { "$ref": "#/$defs/reviewedProfile" },
    { "$ref": "#/$defs/manifest" },
    { "$ref": "#/$defs/results" }
  ],
  "$defs": {
    "hex64": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "reasonCode": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "evidencePaths": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "passRow": {
      "if": {
        "properties": { "outcome": { "const": "PASS" } },
        "required": ["outcome"]
      },
      "then": {
        "properties": {
          "reason_code": { "type": "null" },
          "evidence_paths": { "type": "array", "minItems": 1 }
        }
      }
    },
    "nonPassRow": {
      "if": {
        "properties": {
          "outcome": { "enum": ["FAIL", "BLOCKED", "NOT_RUN", "NOT_APPLICABLE"] }
        },
        "required": ["outcome"]
      },
      "then": {
        "properties": {
          "reason_code": { "type": "string", "minLength": 1 }
        }
      }
    },
    "reviewedProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "profile_id", "browser_login_applicable"],
      "properties": {
        "schema_version": { "const": 1 },
        "profile_id": { "$ref": "#/$defs/nonEmptyString" },
        "browser_login_applicable": { "type": "boolean" }
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "evidence_kind",
        "candidate",
        "profile_id",
        "files"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "evidence_kind": { "enum": ["synthetic", "observed"] },
        "candidate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["commit", "artifact_sha256"],
          "properties": {
            "commit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "artifact_sha256": { "$ref": "#/$defs/hex64" }
          }
        },
        "profile_id": { "$ref": "#/$defs/nonEmptyString" },
        "files": {
          "type": "array",
          "items": { "$ref": "#/$defs/listedFile" }
        }
      }
    },
    "listedFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/hex64" }
      }
    },
    "results": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "candidate_sha256",
        "profile_id",
        "scenarios",
        "subchecks"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "candidate_sha256": { "$ref": "#/$defs/hex64" },
        "profile_id": { "$ref": "#/$defs/nonEmptyString" },
        "scenarios": {
          "type": "array",
          "items": { "$ref": "#/$defs/scenario" }
        },
        "subchecks": {
          "type": "array",
          "items": { "$ref": "#/$defs/subcheck" }
        }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "outcome", "reason_code", "evidence_paths"],
      "properties": {
        "id": {
          "enum": ["INSTALL", "EXECUTE", "RESTART", "ISOLATE", "FAIL-CLOSED"]
        },
        "outcome": { "enum": ["PASS", "FAIL", "BLOCKED", "NOT_RUN"] },
        "reason_code": { "$ref": "#/$defs/reasonCode" },
        "evidence_paths": { "$ref": "#/$defs/evidencePaths" }
      },
      "allOf": [
        { "$ref": "#/$defs/passRow" },
        { "$ref": "#/$defs/nonPassRow" }
      ]
    },
    "subcheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "outcome", "reason_code", "evidence_paths"],
      "properties": {
        "id": { "const": "BROWSER_LOGIN" },
        "outcome": {
          "enum": ["PASS", "FAIL", "BLOCKED", "NOT_RUN", "NOT_APPLICABLE"]
        },
        "reason_code": { "$ref": "#/$defs/reasonCode" },
        "evidence_paths": { "$ref": "#/$defs/evidencePaths" }
      },
      "allOf": [
        { "$ref": "#/$defs/passRow" },
        { "$ref": "#/$defs/nonPassRow" }
      ]
    }
  }
}
