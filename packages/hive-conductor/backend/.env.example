# Copy to `.env` next to this file (backend/) for local runs.
# Never commit real keys.

# --- LiteLLM (OpenAI-compatible API only; must end with /v1) ---
# Hostname: use the **gateway** API host, not the *-admin* UI host.
# Example: https://your-litellm-host.example.com/v1
LITELLM_API_BASE=
LITELLM_API_KEY=

# Default model alias as registered on the LiteLLM proxy (virtual keys / team policy apply server-side).
CHAT_DEFAULT_MODEL=gpt-4o

# --- Degraded-mode opt-in ---
# With LITELLM_API_BASE unset the graph runner REFUSES to run rather than
# returning a fake "stub: no LLM configured" success. Set this to true only if
# you deliberately want stub responses (they are labelled `"stub": true` in the
# payload, and /health reports `degraded: true`).
ALLOW_STUB_LLM=false

# --- LLM HTTP protocol (OpenAI-compatible gateway) ---
# auto = try POST …/v1/responses then fall back to …/v1/chat/completions
# responses | chat_completions = force one path
LLM_HTTP_VARIANT=auto

# --- Langfuse 3.x (optional; Python SDK 3.9+ expects self-hosted platform >= 3.125) ---
# https://langfuse.com/docs/observability/sdk/python/sdk-v3
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Preferred (SDK 3.x): API base of your Langfuse deployment, no trailing slash.
# Example: http://localhost:3000 or https://cloud.langfuse.com
LANGFUSE_BASE_URL=
# Legacy alias — if set and LANGFUSE_BASE_URL is empty, Hive copies this to LANGFUSE_BASE_URL.
LANGFUSE_HOST=

# --- Conductor Foundation (vault, state, privilege, reactor) ---
# Data directory for all conductor state (default: ~/.conductor)
CONDUCTOR_DATA_DIR=~/.conductor
# Vault: age-encrypted secrets file and admin identity key
CONDUCTOR_VAULT_PATH=
CONDUCTOR_IDENTITY_PATH=
# State: SQLite database path (default: <data_dir>/state.db)
CONDUCTOR_STATE_DB=
# Privilege: admin and user public keys for two-tier auth
CONDUCTOR_ADMIN_PUBLIC_KEY=
CONDUCTOR_USER_PUBLIC_KEY=

# --- Human login (OIDC Authorization Code + PKCE) ---
# Disabled until at least one validated provider and this deployment's fixed
# public HTTPS origin are configured. The callback path is always
# /v1/auth/oauth/<provider>/callback; success redirects only to the local path.
OAUTH_PROVIDERS={}
OAUTH_PUBLIC_ORIGIN=
OAUTH_SUCCESS_PATH=/
# Example public metadata (one JSON line when enabled):
# OAUTH_PROVIDERS={"oidc":{"authorization_url":"https://idp.example.com/authorize","token_url":"https://idp.example.com/token","client_id":"conductor","jwks_url":"https://idp.example.com/jwks","issuer":"https://idp.example.com","userinfo_url":"https://idp.example.com/userinfo","client_secret_vault_key":"HIVE_OAUTH_OIDC_CLIENT_SECRET"}}
# Store the actual HIVE_OAUTH_OIDC_CLIENT_SECRET value in the Conductor vault,
# never in this file or OAUTH_PROVIDERS.

# --- Hardware preset ---
# Controls resource limits, worker pool size, queue depth, etc.
# Options: potato | laptop | desktop | beast
HARDWARE_PRESET=laptop
