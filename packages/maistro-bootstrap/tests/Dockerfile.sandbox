FROM python:3.12-slim@sha256:5e2bdb1b0d542d5039cffb8181c65930093949194a65c365dfb1b0fe13a4fa5b

# Security hardening for ADR-093 compliance
# The image is deliberately minimal; isolation strength comes from the
# backend the canonical maistro.sandbox selector evidences (ADR-093, #76,
# M2-B1 #2241), not from container-creation flags here.

RUN apt-get update \
    && apt-get install -y --no-install-recommends git procps util-linux \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user for container operations
RUN useradd -m -u 65532 -s /bin/false appuser

WORKDIR /workspace

# Security directive - the backend applies the runtime boundary; this image
# only promises a minimal, non-root-capable environment (uid 65532)
CMD ["sleep", "infinity"]
