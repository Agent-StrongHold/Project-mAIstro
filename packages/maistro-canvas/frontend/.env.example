# The book-maker POC's configuration. Copy to `.env` and fill in.
#
# One secret, set once. `docker-compose.yml` starts PostgreSQL with this
# password, and `server/config.py` composes the connection URL from it, so the
# application and `alembic upgrade head` cannot disagree about which database
# they are talking to. They used to: both carried their own copy of a URL
# authenticating as `mcp:mcp`, which had stopped matching the Compose profile
# (#432).
#
# There is no default. An unset password is an error at start-up rather than a
# connection attempt against a host nobody named.
POSTGRES_PASSWORD=

# Only when the database is somewhere other than the Compose profile above.
# Set this and POSTGRES_PASSWORD is not consulted.
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname
