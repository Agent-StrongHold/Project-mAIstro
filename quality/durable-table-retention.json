{
  "_doc": "Retention of every durable table in the tree (#325). Checked by scripts/check-durable-table-inventory.py against alembic migrations, runtime CREATE TABLE and ORM __tablename__. 'undecided' means no production-driven deletion path exists today on every listed backend and the decision is tracked on the named issue.",
  "policy_scope": "The engine owns retention mechanisms and this inventory. Legal hold, tamper-evident audit history and lawful-deletion semantics belong to the importing product (owner decision on #325, 2026-09-23; docs/adr/OUT-OF-SCOPE.md). No entry here implements them.",
  "retention_values": {
    "run_purge": "Deleted by the canonical Run purge; dependents follow packages/maistro-core/src/maistro/runs/retention_scope.py.",
    "ttl_purge": "Deleted by a driven TTL purge on every backend listed.",
    "window_prune": "Rows outside a sliding window or population bound are deleted by a driven path.",
    "bounded_by_parent": "Deleted with its parent row; lives exactly as long as the parent.",
    "indefinite_by_decision": "Kept forever on purpose; the issue records the decision.",
    "undecided": "No production-driven deletion path on every listed backend today. deletion_path, if any, is an explicit, test-only or single-backend delete, not a retention sweep."
  },
