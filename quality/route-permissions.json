      {"methods": ["*"], "path": "/v1/profile", "kind": "prefix", "access": "permission", "permission": "profile.write", "reason": "Profile data is an authenticated user surface."},
      {"methods": ["*"], "path": "/v1/settings", "kind": "prefix", "access": "permission", "permission": "config.write", "reason": "Settings alter deployment behavior."},
      {"methods": ["*"], "path": "/v1/capabilities", "kind": "prefix", "access": "permission", "permission": "config.write", "reason": "Capability approval changes executable authority."},
      {"methods": ["*"], "path": "/v1/design", "kind": "prefix", "access": "permission", "permission": "design.write", "reason": "Design routes create and render user assets."},
      {"methods": ["*"], "path": "/v1/harness", "kind": "prefix", "access": "permission", "permission": "harness.execute", "reason": "Harness routes execute code on the host."},
      {"methods": ["*"], "path": "/v1/voice", "kind": "prefix", "access": "permission", "permission": "voice.write", "reason": "Voice intent is an authenticated control surface."},
      {"methods": ["*"], "path": "/v1/setup-checklist", "kind": "prefix", "access": "permission", "permission": "config.write", "reason": "Checklist mutations alter setup state."},
      {"methods": ["*"], "path": "/v1/widgets", "kind": "prefix", "access": "permission", "permission": "widgets.read", "reason": "Widget data is not public deployment state."},
      {"methods": ["*"], "path": "/v1/dags", "kind": "prefix", "access": "permission", "permission": "dags.write", "reason": "DAG definitions and runs execute agent work."},
      {"methods": ["*"], "path": "/v1/dashboard", "kind": "prefix", "access": "permission", "permission": "dashboard.read", "reason": "Dashboard data is an authenticated product surface."},
      {"methods": ["*"], "path": "/v1/dag-runs", "kind": "prefix", "access": "permission", "permission": "dags.read", "reason": "Run history and cancellation expose or control execution."},
      {"methods": ["*"], "path": "/v1/dag-metrics", "kind": "prefix", "access": "permission", "permission": "dags.read", "reason": "Execution metrics are scoped product data."},
      {"methods": ["*"], "path": "/v1/eval-judge", "kind": "prefix", "access": "permission", "permission": "dags.read", "reason": "Evaluation results describe graph execution."},
      {"methods": ["*"], "path": "/v1/optimizer", "kind": "prefix", "access": "permission", "permission": "dags.write", "reason": "Optimizer routes can rewrite executable DAGs."},
      {"methods": ["*"], "path": "/v1/topology", "kind": "prefix", "access": "permission", "permission": "dags.read", "reason": "Topology data is scoped graph information."},
      {"methods": ["*"], "path": "/v1/messages", "kind": "prefix", "access": "permission", "permission": "messages.write", "reason": "Messages are authenticated user data."},
      {"methods": ["*"], "path": "/v1/audit", "kind": "prefix", "access": "permission", "permission": "audit.write", "reason": "Audit records require controlled authority."},
      {"methods": ["*"], "path": "/v1/quotas", "kind": "prefix", "access": "permission", "permission": "quotas.read", "reason": "Quota state is deployment-scoped data."},
      {"methods": ["*"], "path": "/v1/confirms", "kind": "prefix", "access": "permission", "permission": "dags.write", "reason": "Confirmation responses can resume execution."},
      {"methods": ["*"], "path": "/v1/canvas", "kind": "prefix", "access": "permission", "permission": "canvas.write", "reason": "Canvas operations mutate design execution state."},
      {"methods": ["*"], "path": "/v1/evolution", "kind": "prefix", "access": "permission", "permission": "rsi.execute", "reason": "Evolution routes control self-improvement work."},
      {"methods": ["*"], "path": "/v1/rsi", "kind": "prefix", "access": "permission", "permission": "rsi.execute", "reason": "RSI routes execute repository-changing work."}
    ],
    "turing": [
      {"methods": ["GET"], "path": "/docs", "kind": "prefix", "access": "public", "owner": "@BlakeMatthews-dev", "risk": "medium", "disposition": "permanent", "reason": "FastAPI documentation is public by reviewed declaration."},
      {"methods": ["GET"], "path": "/openapi.json", "kind": "exact", "access": "public", "owner": "@BlakeMatthews-dev", "risk": "medium", "disposition": "permanent", "reason": "The docs renderer loads the public schema path."},
      {"methods": ["GET"], "path": "/redoc", "kind": "prefix", "access": "public", "owner": "@BlakeMatthews-dev", "risk": "medium", "disposition": "permanent", "reason": "The alternate docs renderer is public by reviewed declaration."},
      {"methods": ["GET"], "path": "/health", "kind": "exact", "access": "public", "owner": "@BlakeMatthews-dev", "risk": "low", "disposition": "permanent", "reason": "The liveness probe returns only a fixed service status."},
      {"methods": ["POST"], "path": "/v1/auth/login", "kind": "exact", "access": "public", "owner": "@BlakeMatthews-dev", "risk": "low", "disposition": "permanent", "reason": "A caller must reach login before it can establish a session."},
      {"methods": ["GET"], "path": "/v1/auth/whoami", "kind": "exact", "access": "public", "owner": "@BlakeMatthews-dev", "risk": "low", "disposition": "permanent", "reason": "The frontend checks only its own session state."},
      {"methods": ["GET"], "path": "/v1/state", "kind": "prefix", "access": "permission", "permission": "turing.read", "reason": "Self-model state is available only to an authenticated Turing caller."},
      {"methods": ["GET"], "path": "/v1/feed", "kind": "prefix", "access": "permission", "permission": "turing.read", "reason": "Producer artifacts are authenticated Turing data."},
      {"methods": ["POST"], "path": "/v1/feed", "kind": "prefix", "access": "permission", "permission": "turing.write", "reason": "Publishing an artifact is restricted to the internal write scope."},
      {"methods": ["POST"], "path": "/v1/chat", "kind": "prefix", "access": "permission", "permission": "turing.chat", "reason": "Chat invokes the canonical Turing execution path."},
      {"methods": ["*"], "path": "/v1/admin", "kind": "prefix", "access": "permission", "permission": "turing.admin", "reason": "Self-model mutation and administration require the human admin lane."}
