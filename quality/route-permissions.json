{
  "$comment": [
    "One declaration table for the live Conductor and Turing FastAPI applications.",
    "The gate imports each app and audits its actual app.routes; an absent or failed import is an error.",
    "Entries use exact paths, boundary-safe prefixes, or an explicitly reviewed template.",
    "permission values are canonical scope.verb names shared with Principal.scopes and Binding policy."
  ],
  "routes": {
    "conductor": [
      {"methods": ["GET"], "path": "/docs", "kind": "prefix", "access": "public", "owner": "@BlakeMatthews-dev", "risk": "medium", "disposition": "permanent", "reason": "FastAPI documentation is a reviewed public disclosure."},
      {"methods": ["GET"], "path": "/openapi", "kind": "loose-prefix", "access": "public", "owner": "@BlakeMatthews-dev", "risk": "medium", "disposition": "permanent", "reason": "The docs renderer loads the public schema path."},
      {"methods": ["GET"], "path": "/redoc", "kind": "prefix", "access": "public", "owner": "@BlakeMatthews-dev", "risk": "medium", "disposition": "permanent", "reason": "The alternate docs renderer is a reviewed public disclosure."},
      {"methods": ["GET"], "path": "/health", "kind": "prefix", "access": "public", "owner": "@BlakeMatthews-dev", "risk": "low", "disposition": "permanent", "reason": "Health probes return liveness without a credential."},
      {"methods": ["POST"], "path": "/v1/auth/register", "kind": "exact", "access": "public", "owner": "@BlakeMatthews-dev", "risk": "high", "disposition": "temporary", "issue": 313, "expires": "2026-11-24", "reason": "First-run account creation remains a reviewed temporary exception."},
      {"methods": ["POST"], "path": "/v1/auth/login", "kind": "exact", "access": "public", "owner": "@BlakeMatthews-dev", "risk": "low", "disposition": "permanent", "reason": "A caller must reach login before it can authenticate."},
      {"methods": ["GET"], "path": "/v1/auth/whoami", "kind": "exact", "access": "public", "owner": "@BlakeMatthews-dev", "risk": "low", "disposition": "permanent", "reason": "The frontend checks only its own session."},
      {"methods": ["*"], "path": "/v1/auth", "kind": "prefix", "access": "permission", "permission": "identity.write", "reason": "Authentication administration is protected after the public login and callback exceptions."},
      {"methods": ["GET"], "path": "/v1/auth/oauth/{provider}/start", "kind": "template", "access": "public", "owner": "@BlakeMatthews-dev", "risk": "medium", "disposition": "permanent", "reason": "Configured OAuth providers need an unauthenticated start endpoint."},
      {"methods": ["GET"], "path": "/v1/auth/oauth/{provider}/callback", "kind": "template", "access": "public", "owner": "@BlakeMatthews-dev", "risk": "medium", "disposition": "permanent", "reason": "The identity provider callback has no session yet and is constrained by provider validation."},
      {"methods": ["*"], "path": "/v1/setup", "kind": "prefix", "access": "public", "owner": "@BlakeMatthews-dev", "risk": "high", "disposition": "temporary", "issue": 313, "expires": "2026-11-24", "reason": "Pre-account setup routes are public until setup is narrowed to its one-shot window."},
      {"methods": ["*"], "path": "/v1/credentials", "kind": "prefix", "access": "permission", "permission": "credentials.read", "reason": "Credential configuration is an authenticated security surface."},
      {"methods": ["*"], "path": "/v1/install", "kind": "prefix", "access": "permission", "permission": "config.write", "reason": "Install-session state changes deployment configuration."},
      {"methods": ["*"], "path": "/v1/providers", "kind": "prefix", "access": "permission", "permission": "config.write", "reason": "Provider activation and keys affect model egress."},
      {"methods": ["*"], "path": "/v1/chat", "kind": "prefix", "access": "permission", "permission": "chat.read", "reason": "Conversation history is an authenticated user surface."},
      {"methods": ["*"], "path": "/v1/hitl", "kind": "prefix", "access": "permission", "permission": "dags.write", "reason": "HITL answers and cancellation control graph execution."},
      {"methods": ["*"], "path": "/v1/tasks", "kind": "prefix", "access": "permission", "permission": "tasks.write", "reason": "Task operations create and mutate user work."},
      {"methods": ["*"], "path": "/v1/schedules", "kind": "prefix", "access": "permission", "permission": "schedules.write", "reason": "Schedules create recurring execution."},
