      {"methods": ["*"], "path": "/v1/program", "kind": "prefix", "access": "permission", "permission": "program.write", "reason": "Program guidance and pulse operations control agent work."},
      {"methods": ["*"], "path": "/v1/work-items", "kind": "prefix", "access": "permission", "permission": "work_items.write", "reason": "Work-item drafting and posting are authenticated operations."},
      {"methods": ["*"], "path": "/v1/workspaces", "kind": "prefix", "access": "permission", "permission": "workspaces.write", "reason": "Workspace membership and settings are scoped mutations."},
      {"methods": ["*"], "path": "/v1/mcp", "kind": "prefix", "access": "permission", "permission": "mcp.write", "reason": "MCP registration and discovery reach operator endpoints."},
