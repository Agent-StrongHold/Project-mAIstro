[project]
name = "{{ project_slug }}"
version = "0.1.0"
description = "Single-tenant multi-user Maistro product overlay"
readme = "README.md"
requires-python = ">=3.12"
dependencies = [
    "maistro-core @ git+https://github.com/Agent-StrongHold/Project-mAIstro.git@74218cf762d7b704732b3a22ff1dd90e49273aee#subdirectory=packages/maistro-core",
]

[project.optional-dependencies]
dev = [
    "cosmic-ray>=8.0,<9",
    "pytest>=8.3,<10",
    "pytest-timeout>=2.3,<3",
    "ruff>=0.9,<1",
]

[project.scripts]
"{{ project_slug }}" = "{{ project_slug | replace('-', '_') }}.main:main"

[build-system]
requires = ["hatchling>=1.27"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["src/{{ project_slug | replace('-', '_') }}"]

[tool.hatch.metadata]
allow-direct-references = true

[tool.pytest.ini_options]
testpaths = ["tests"]
pythonpath = ["src"]
markers = [
    "contract: ADR-032 contract axis (boundary | behavioral | cross-service)",
    "scope: test scope axis (unit | integration | e2e | property)",
]

[tool.ruff]
target-version = "py312"
line-length = 100

[tool.ruff.lint]
select = ["E", "F", "I", "UP", "B", "SIM", "RUF"]
