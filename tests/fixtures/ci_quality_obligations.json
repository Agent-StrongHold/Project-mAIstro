  "workflow": {
    "name": "quality",
    "permissions": {
      "contents": "read"
    },
    "triggers": {
      "pull_request": null,
      "merge_group": {
        "types": [
          "checks_requested"
        ]
      },
      "push": {
        "branches": [
          "main",
          "integration",
          "develop",
          "feat/*",
          "bug/*",
          "fix/*",
          "idea/*",
          "doc/*",
          "docs/*",
          "chore/*"
        ]
      }
    },
    "concurrency": {
      "group": "quality-${{ github.event.pull_request.number || github.event.merge_group.head_sha || github.ref }}",
      "cancel-in-progress": "${{ github.event_name == 'pull_request' || github.event_name == 'merge_group' }}"
    }
  },
  "setup_steps": [
    {
      "uses": "actions/checkout@v7",
      "with": {
        "fetch-depth": 0
      }
    },
    {
      "name": "Install uv",
      "uses": "./.github/actions/setup-uv"
    },
    {
      "name": "Setup Python 3.12",
      "run": "uv python install 3.12"
    },
    {
      "name": "uv sync (full dev deps)",
      "run": "uv sync --locked --all-extras"
    },
    {
      "name": "install maistro-evolve",
      "run": "uv pip install -e packages/maistro-evolve"
    }
  ],
  "ratchet_base_rev": "${{ github.event_name == 'pull_request'\n    && format('origin/{0}', github.base_ref)\n    || github.event_name == 'merge_group'\n    && github.event.merge_group.base_sha\n    || github.ref == 'refs/heads/develop'\n    && github.event.before\n    || github.ref == 'refs/heads/integration'\n    && github.event.before\n    || github.ref == 'refs/heads/main'\n    && github.event.before\n    || 'origin/develop' }}",
  "postgres_services": {
    "postgres": {
      "image": "pgvector/pgvector:pg18",
      "env": {
        "POSTGRES_USER": "maistro",
        "POSTGRES_PASSWORD": "maistro",
        "POSTGRES_DB": "maistro_test"
      },
      "ports": [
        "5432:5432"
      ],
      "options": "--health-cmd \"pg_isready -U maistro -d maistro_test\" --health-interval 5s --health-timeout 5s --health-retries 10"
    }
  },
  "postgres_env": {
    "MAISTRO_TEST_PG_DSN": "postgresql://maistro:maistro@127.0.0.1:5432/maistro_test",
    "DATABASE_URL": "postgresql://maistro:maistro@127.0.0.1:5432/maistro_test"
  },
  "age_step_sha256": "0d31883f5ff7314c52dbfafb7334dcdfbe07190894cd2b96234b6209ab163875",
  "coverage_jobs": {
    "coverage-unit": "81c343adca11aa9e82f74aa6c891a4707a9e6a64109194f83fe274c23a0cbe9e",
    "coverage-archive": "c2e6d0aecd422d0456f6e8c42aa00afd6797099d1cef810f1fc725b61f688a09",
